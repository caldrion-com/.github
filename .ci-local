# Pull request and merge-train checks, run on a Mac by Factory's machine/ci-local.sh and machine/train-check.sh.
# This repo holds the organization profile and community files (no build, no package.json), so the checks are light
# and offline: the system Ruby only, no network, no installs.
# Each line runs on its own in a cleared environment from the repo root.
#
# 1. Every YAML file parses; issue forms have name, description and a body of typed fields with unique ids;
#    config.yml's contact links each have a name, an https url and an about line.
ruby -ryaml -e 'e=[]; f=Dir.glob("{*,.github/**/*}.{yml,yaml}", File::FNM_DOTMATCH).sort; f.empty? && e << "no YAML files found"; f.each { |p| begin; y=YAML.safe_load(File.read(p)); rescue => x; e << "#{p}: #{x.message}"; next; end; next unless p.start_with?(".github/ISSUE_TEMPLATE/"); if File.basename(p, ".*") == "config"; (y["contact_links"] || []).each_with_index { |l, i| %w[name url about].each { |k| e << "#{p}: contact_links[#{i}] has no #{k}" if l[k].to_s.strip.empty? }; e << "#{p}: contact_links[#{i}] url is not https" unless l["url"].to_s.start_with?("https://") }; else; %w[name description].each { |k| e << "#{p}: no #{k}" if y[k].to_s.strip.empty? }; b=y["body"]; if !b.is_a?(Array) || b.empty?; e << "#{p}: body is not a list of fields"; else; b.each_with_index { |x, i| e << "#{p}: body[#{i}] has no type" if x["type"].to_s.empty? }; ids=b.map { |x| x["id"] }.compact; ids.uniq.size == ids.size || e << "#{p}: duplicate field ids"; end; end }; e.each { |m| warn m }; puts "yaml: #{f.size} files, #{e.size} problems"; exit(e.empty? ? 0 : 1)'
# 2. Every Markdown file's local links and images (Markdown and HTML) point at a file that exists in the repo.
ruby -e 'e=[]; f=Dir.glob("{*,.github/**/*,profile/**/*}.md", File::FNM_DOTMATCH).sort; f.empty? && e << "no Markdown files found"; n=0; f.each { |p| s=File.read(p); s.scan(/\]\(([^)\s]+)[^)]*\)|(?:src|href)="([^"]+)"/).flatten.compact.each { |t| next if t =~ /\A([a-z]+:|#)/i; n+=1; q=t.sub(/[#?].*/, ""); r=q.start_with?("/") ? q[1..] : File.join(File.dirname(p), q); e << "#{p}: #{t} not found" unless File.exist?(r) } }; e.each { |m| warn m }; puts "markdown: #{f.size} files, #{n} local links, #{e.size} problems"; exit(e.empty? ? 0 : 1)'
